{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 20,
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(tree *)",
      "Bash(pytest *)",
      "Bash(pip *)",
      "Bash(source ~/.venv_gen/bin/activate)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)",
      "Read(~/.gitconfig)",
      "Bash(ls:*)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(git add *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Preferences/**)",
      "Read(~/Library/Application Support/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Saved Application State/**)",
      "Read(~/Library/Caches/**)",
      "Read(~/Library/HTTPStorages/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(/etc/**)",
      "Read(/var/**)",
      "Read(/private/**)",
      "Bash(open *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rm *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git clean *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(docker *)",
      "Bash(kill *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(nc *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(netstat *)",
      "Bash(pbpaste)",
      "Bash(pbcopy)",
      "Bash(screencapture *)",
      "Bash(dd *)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(crontab *)"
    ],
    "defaultMode": "default"
  },
  "model": "haiku",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "allowedMcpServers": [],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "nextjs-expert@buildwithclaude": true,
    "commands-code-analysis-testing@buildwithclaude": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "agents-language-specialists@buildwithclaude": true
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "docker"
    ]
  },
  "spinnerTipsEnabled": true,
  "effortLevel": "low",
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "showTurnDuration": true,
  "skipAutoPermissionPrompt": true
}